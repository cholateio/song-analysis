# Copy to .env and fill in real values before running analyzer.mjs.
# The analyzer fails fast if either variable is missing.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key (NOT the anon key). Required because analyzer.mjs upserts
# into the "Songs" table bypassing row-level security.
SUPABASE_SERVICE_KEY=
